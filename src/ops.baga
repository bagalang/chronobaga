// ops.baga — compare and shift dates (chrono Datelike + Duration in days/months).

import "types.baga"
import "cal.baga"

fn dt_cmp(a: Date, b: Date) -> i64 {
    if a.year < b.year { return 0 - 1 }
    if a.year > b.year { return 1 }
    if a.month < b.month { return 0 - 1 }
    if a.month > b.month { return 1 }
    if a.day < b.day { return 0 - 1 }
    if a.day > b.day { return 1 }
    return 0
}

fn dt_eq(a: Date, b: Date) -> i64 {
    if dt_cmp(a, b) == 0 {
        return 1
    }
    return 0
}

fn dt_lt(a: Date, b: Date) -> i64 {
    if dt_cmp(a, b) < 0 {
        return 1
    }
    return 0
}

fn dt_le(a: Date, b: Date) -> i64 {
    if dt_cmp(a, b) <= 0 {
        return 1
    }
    return 0
}

fn dt_gt(a: Date, b: Date) -> i64 {
    if dt_cmp(a, b) > 0 {
        return 1
    }
    return 0
}

fn dt_ge(a: Date, b: Date) -> i64 {
    if dt_cmp(a, b) >= 0 {
        return 1
    }
    return 0
}

fn dt_min(a: Date, b: Date) -> Date {
    if dt_lt(a, b) == 1 {
        return a
    }
    return b
}

fn dt_max(a: Date, b: Date) -> Date {
    if dt_gt(a, b) == 1 {
        return a
    }
    return b
}

fn dt_add_days(d: Date, n: i64) -> DtResult {
    return dt_from_unix_days(dt_unix_days(d) + n)
}

fn dt_add_months(d: Date, n: i64) -> DtResult {
    let total = d.year * 12 + (d.month - 1) + n
    if total < 12 {
        return dt_err("month shift before year 1")
    }
    if total >= 10000 * 12 {
        return dt_err("month shift after year 9999")
    }
    let y = total / 12
    let m = total % 12 + 1
    let dim = dt_days_in_month(y, m)
    let mut day = d.day
    if day > dim {
        day = dim
    }
    return dt_ymd(y, m, day)
}

fn dt_add_years(d: Date, n: i64) -> DtResult {
    return dt_add_months(d, n * 12)
}

fn dt_diff_days(a: Date, b: Date) -> i64 {
    return dt_unix_days(a) - dt_unix_days(b)
}
