// cal.baga — Gregorian calendar (Howard Hinnant days_from_civil / civil_from_days).
// Same family as chrono NaiveDate: proleptic Gregorian, no leap seconds.
// Serial day 0 = 1970-01-01 (unix epoch day).

import "types.baga"

fn dt_is_leap(y: i64) -> i64 {
    if y % 4 != 0 {
        return 0
    }
    if y % 100 != 0 {
        return 1
    }
    if y % 400 == 0 {
        return 1
    }
    return 0
}

fn dt_days_in_month(y: i64, m: i64) -> i64 {
    if m == 1 || m == 3 || m == 5 || m == 7 || m == 8 || m == 10 || m == 12 {
        return 31
    }
    if m == 4 || m == 6 || m == 9 || m == 11 {
        return 30
    }
    if m == 2 {
        return 28 + dt_is_leap(y)
    }
    return 0
}

fn dt_ymd(y: i64, m: i64, d: i64) -> DtResult {
    if y < 1 || y > 9999 {
        return dt_err("year out of range 1..9999")
    }
    if m < 1 || m > 12 {
        return dt_err("month out of range 1..12")
    }
    let dim = dt_days_in_month(y, m)
    if d < 1 || d > dim {
        return dt_err("day out of range for month")
    }
    return dt_ok(Date { year: y, month: m, day: d })
}

fn dt_ordinal(d: Date) -> i64 {
    let mut n = d.day
    let mut m: i64 = 1
    while m < d.month {
        n = n + dt_days_in_month(d.year, m)
        m = m + 1
    }
    return n
}

// Days since 1970-01-01. Year is in 1..9999 so the era shift stays non-negative.
fn dt_days_from_civil(y: i64, m: i64, d: i64) -> i64 {
    let mut yy = y
    if m <= 2 {
        yy = y - 1
    }
    let era = yy / 400
    let yoe = yy - era * 400
    let mut mp = m + 9
    if m > 2 {
        mp = m - 3
    }
    let doy = (153 * mp + 2) / 5 + d - 1
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    return era * 146097 + doe - 719468
}

fn dt_civil_from_days(z: i64) -> Date {
    let z2 = z + 719468
    let era = z2 / 146097
    let doe = z2 - era * 146097
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    let y = yoe + era * 400
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    let mp = (5 * doy + 2) / 153
    let d = doy - (153 * mp + 2) / 5 + 1
    let mut m = mp + 3
    if mp >= 10 {
        m = mp - 9
    }
    let mut year = y
    if m <= 2 {
        year = y + 1
    }
    return Date { year: year, month: m, day: d }
}

fn dt_unix_days(d: Date) -> i64 {
    return dt_days_from_civil(d.year, d.month, d.day)
}

// chrono NaiveDate::num_days_from_ce — 0001-01-01 is day 1.
fn dt_num_days_from_ce(d: Date) -> i64 {
    return dt_unix_days(d) + 719163
}

fn dt_from_unix_days(z: i64) -> DtResult {
    if z < 0 - 719162 || z > 2932896 {
        return dt_err("unix day out of range")
    }
    let d = dt_civil_from_days(z)
    return dt_ymd(d.year, d.month, d.day)
}

fn dt_from_num_days_from_ce(n: i64) -> DtResult {
    return dt_from_unix_days(n - 719163)
}

fn dt_from_unix_ms(ms: i64) -> DtResult {
    let mut days = ms / 86400000
    let rem = ms % 86400000
    if rem < 0 {
        days = days - 1
    }
    return dt_from_unix_days(days)
}

fn dt_mod7(n: i64) -> i64 {
    let r = n % 7
    if r < 0 {
        return r + 7
    }
    return r
}

// ISO weekday: 1 = Monday … 7 = Sunday. 1970-01-01 is Thursday (4).
fn dt_weekday(d: Date) -> i64 {
    return dt_mod7(dt_unix_days(d) + 3) + 1
}

fn dt_quarter(d: Date) -> i64 {
    return (d.month - 1) / 3 + 1
}
